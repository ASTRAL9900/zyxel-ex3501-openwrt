+/* EN7523 (hypothesis 34): the PPE reports HIT_UNBIND_RATE_REACHED with a
+ * valid FOE index but never writes the unbind entry (tuple) into the DRAM
+ * table -- the table stays all-zero (verified with debugfs ppe/raw64 and
+ * /dev/mem scans after 30k RATE_REACHED events).  Vendor hw_nat.ko does not
+ * depend on it either: PpeTxHandler() builds the whole entry from the skb
+ * (PpeParseLayerInfo/PpeFillInL2Info/L3Info/L4Info) and then sets the bind
+ * state.  Do the same: parse the IPv4 5-tuple from the received frame and
+ * match it against the flow table instead of comparing with the (empty)
+ * hardware entry.  The frame at skb->data still carries the in-band 4-byte
+ * MT7530 special tag (hypothesis 30) before the ethertype.
+ */
+static bool airoha_ppe_en7523_skb_tuple(struct sk_buff *skb,
+					struct airoha_foe_ipv4_tuple *t,
+					u8 *l4proto)
+{
+	const struct udphdr *uh;
+	const struct iphdr *iph;
+	const u8 *p = skb->data;
+	int room = skb_headlen(skb);
+	__be16 proto;
+
+	/* eth_type_trans() already pulled the MAC header; read the real
+	 * ethertype from it (skb->protocol is ETH_P_XDSA on a DSA conduit).
+	 */
+	proto = eth_hdr(skb)->h_proto;
+	if (proto == htons(ETH_P_8021Q)) {
+		if (room < 4)
+			return false;
+		proto = get_unaligned((const __be16 *)(p + 2));
+		p += 4;
+		room -= 4;
+	}
+	if (proto != htons(ETH_P_IP) || room < (int)sizeof(*iph))
+		return false;
+
+	iph = (const struct iphdr *)p;
+	if (iph->version != 4 || iph->ihl < 5 || room < iph->ihl * 4 + 4)
+		return false;
+
+	*l4proto = iph->protocol;
+	t->src_ip = ntohl(iph->saddr);
+	t->dest_ip = ntohl(iph->daddr);
+	if (iph->protocol == IPPROTO_TCP || iph->protocol == IPPROTO_UDP) {
+		uh = (const struct udphdr *)(p + iph->ihl * 4);
+		t->src_port = ntohs(uh->source);
+		t->dest_port = ntohs(uh->dest);
+	} else {
+		t->ports = 0xa5a5a500 | iph->protocol;
+	}
+
+	return true;
+}
+
+static bool airoha_ppe_en7523_flow_match(struct airoha_flow_table_entry *e,
+					 const struct airoha_foe_ipv4_tuple *t,
+					 u8 l4proto)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
+	const struct airoha_foe_ipv4_tuple *o = &e->data.ipv4.orig_tuple;
+	bool udp = !!(e->data.ib1 & AIROHA_FOE_IB1_BIND_UDP);
+
+	if (e->type != FLOW_TYPE_L4)
+		return false;
+	if (type != PPE_PKT_TYPE_IPV4_HNAPT && type != PPE_PKT_TYPE_IPV4_ROUTE)
+		return false;
+	if (o->src_ip != t->src_ip || o->dest_ip != t->dest_ip)
+		return false;
+	if (type == PPE_PKT_TYPE_IPV4_HNAPT) {
+		if (l4proto != (udp ? IPPROTO_UDP : IPPROTO_TCP))
+			return false;
+		return o->src_port == t->src_port &&
+		       o->dest_port == t->dest_port;
+	}
+
+	return o->ports == t->ports;
+}
+
+static bool airoha_ppe_en7523_insert_entry(struct airoha_ppe *ppe,
+					   struct sk_buff *skb, u32 hash,
+					   bool rx_wlan)
+{
+	static const int types[] = { PPE_PKT_TYPE_IPV4_HNAPT,
+				     PPE_PKT_TYPE_IPV4_ROUTE };
+	struct airoha_foe_ipv4_tuple t = {};
+	struct airoha_flow_table_entry *e;
+	struct airoha_foe_entry tmp = {};
+	bool commit_done = false;
+	struct hlist_node *n;
+	u8 l4proto;
+	int i;
+
+	lockdep_assert_held(&ppe_lock);
+
+	if (!airoha_ppe_en7523_skb_tuple(skb, &t, &l4proto))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(types) && !commit_done; i++) {
+		u32 index;
+
+		tmp.ib1 = FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, types[i]);
+		tmp.ipv4.orig_tuple = t;
+		if (types[i] == PPE_PKT_TYPE_IPV4_ROUTE)
+			tmp.ipv4.orig_tuple.ports = 0xa5a5a500 | l4proto;
+		index = airoha_ppe_foe_get_entry_hash(ppe, &tmp);
+
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[index], list) {
+			if (!airoha_ppe_en7523_flow_match(e, &t, l4proto))
+				continue;
+
+			airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan);
+			commit_done = true;
+			e->hash = hash;
+		}
+	}
+
+	return commit_done;
+}
