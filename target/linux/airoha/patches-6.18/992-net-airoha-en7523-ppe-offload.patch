+	airoha_fe_wr(eth, REG_PPE_BND_AGE0(0),
+		     FIELD_PREP(PPE_BIND_AGE0_DELTA_NON_L4, 60) |
+		     FIELD_PREP(PPE_BIND_AGE0_DELTA_UDP, 60));
+	airoha_fe_wr(eth, REG_PPE_BND_AGE1(0),
